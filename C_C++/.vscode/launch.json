{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "C/C++: gcc.exe 生成活动文件", //这里要和 tasks.json 的 "label" 值相同
        "type": "cppdbg",
        "request": "launch",
        "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${fileDirname}",
        "environment": [],
        "externalConsole": true, //喜欢用外部弹出控制台(cmd / powershell风格)的填true，喜欢用vscode内置控制台的填false
        "MIMode": "gdb",
        "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe", //改成你的gdb路径
        "setupCommands": [
            {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
            }
        ],
        "preLaunchTask": "C/C++: gcc.exe 生成活动文件"
      }
     ]
    }